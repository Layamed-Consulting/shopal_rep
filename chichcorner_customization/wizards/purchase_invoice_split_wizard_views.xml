<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_invoice_split_wizard_form" model="ir.ui.view">
        <field name="name">purchase.invoice.split.wizard.form</field>
        <field name="model">purchase.invoice.split.wizard</field>
        <field name="arch" type="xml">
            <form string="Select invoices to generate">
                <field name="order_ids" invisible="1"/>
                <p class="text-muted">
                    Cette commande d'achat comporte plusieurs numéros de facture.
                    Choisissez ceux pour lesquels vous souhaitez générer une facture.
                </p>
                <field name="line_ids">
                    <tree editnumero_factureable="bottom" decoration-muted="already_invoiced" create="0" delete="0">
                        <field name="order_id"/>
                        <field name="numero_facture" placeholder="(No number)"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="amount_total" sum="Total"/>
                        <field name="state" widget="badge"
                               decoration-success="state == 'to_invoice'"
                               decoration-muted="state == 'invoiced'"/>
                        <field name="already_invoiced" column_invisible="1"/>
                        <field name="to_generate" readonly="already_invoiced"/>
                    </tree>
                </field>
                <footer>
                    <button name="action_generate_invoices" type="object"
                            string="Générer les factures sélectionnées" class="btn-success"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
